<!-- app/views/comments/_form.html.erb -->

<%= simple_form_for(@comment) do |f| %>
  <%= f.error_notification %>
  <% if f.object.errors[:base].present? %>
    <%= f.error_notification message: f.object.errors[:base].to_sentence %>
  <% end %>

  <div class="form-inputs">
    <%= f.hidden_field :photo_id %>
    <%= f.input :body, label: false, placeholder: "Add your comment here...", input_html: { class: "form-control" } %>
  </div>

  <div class="form-actions">
    <%= f.button :submit, "Post Comment", class: "btn btn-outline-secondary" %>
  </div>
<% end %>
